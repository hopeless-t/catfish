#!/bin/sh
set -eu
ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
export PATH="$HOME/.local/bin:/usr/local/bin:/usr/bin:/bin"
export CATFISH_AGENT_BROWSER="${CATFISH_AGENT_BROWSER:-$(command -v agent-browser)}"
export CATFISH_CURL="${CATFISH_CURL:-$(command -v curl)}"
exec "$ROOT/.venv/bin/catfish-mcp"
